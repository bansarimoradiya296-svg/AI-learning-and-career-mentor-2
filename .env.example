# Server Configuration
ENV=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=replace_with_a_very_long_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_mentor
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DB URLs (Use 'localhost' for local running outside Docker, 'db' for Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_mentor
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_mentor


# Vector Database (ChromaDB)
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# AI Configuration (Google Gemini API)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# Social Authentication OAuth2 (Optional, leave empty to disable UI buttons)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Email Configuration (For OTP/Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=no-reply@aimentor.com
SMTP_FROM_NAME="AI Learning & Career Mentor"
